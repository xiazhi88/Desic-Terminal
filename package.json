{
  "name": "desic-terminal",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiazhi88/Desic-Terminal.git"
  },
  "homepage": "https://github.com/xiazhi88/Desic-Terminal",
  "type": "module",
  "description": "Desic Terminal desktop trading application",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "predev": "node scripts/kill-dev-port.mjs",
    "dev:ready": "node scripts/start-dev-ready.mjs",
    "prepare:sidecar": "node scripts/prepare-sidecar-resources.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:ai-policy": "node scripts/test-cline-tool-policy.mjs",
    "test:ai-multi-agent": "node scripts/test-cline-profile-agents.mjs",
    "test:ai-stream": "node scripts/test-cline-event-stream.mjs",
    "test:ai-codex": "node scripts/test-codex-cli-adapter.mjs",
    "test:ai-codex-integration": "node scripts/test-codex-cli-sidecar.mjs",
    "test:ai-claude": "node scripts/test-claude-cli-adapter.mjs",
    "test:ai-claude-integration": "node scripts/test-claude-cli-sidecar.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:release-version": "node scripts/check-release-version.mjs",
    "smoke:i18n-preview": "node scripts/smoke-i18n-preview.mjs",
    "smoke:terminal-preview": "node scripts/smoke-terminal-preview.mjs",
    "smoke:trade-ticket-preview": "node scripts/smoke-trade-ticket-preview.mjs",
    "smoke:market-order-consistency": "node scripts/smoke-market-order-consistency.mjs",
    "smoke:intelligence-preview": "node scripts/smoke-intelligence-preview.mjs",
    "smoke:intelligence-final-review": "node scripts/smoke-intelligence-final-review.mjs",
    "smoke:startup-preview": "node scripts/smoke-startup-preview.mjs",
    "smoke:first-launch-onboarding": "node scripts/smoke-first-launch-onboarding.mjs",
    "smoke:chart-preview": "node scripts/smoke-chart-preview.mjs",
    "smoke:ai-preview": "node scripts/smoke-ai-preview.mjs",
    "smoke:automation-preview": "node scripts/smoke-automation-preview.mjs",
    "smoke:okx-kline": "node scripts/smoke-okx-kline-continuity.mjs",
    "smoke:local-kline": "node scripts/smoke-local-kline-integrity.mjs",
    "smoke:local-kline-sync": "node scripts/smoke-local-kline-sync.mjs",
    "smoke:okx-ws": "node scripts/smoke-okx-ws-probes.mjs",
    "smoke:okx-multi-ticker": "node scripts/smoke-okx-multi-ticker.mjs",
    "smoke:private-rest": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_private_rest",
    "smoke:private-ws": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_private_ws",
    "smoke:private-reconcile": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_private_reconcile",
    "smoke:private-history-audit": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_private_history_audit",
    "smoke:private-history-sync": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_private_history_sync",
    "smoke:position-episodes": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_position_episodes_rebuild",
    "smoke:storage-maintenance": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_storage_maintenance",
    "smoke:config-security": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_config_security",
    "smoke:trade-readiness": "cargo run --manifest-path src-tauri/Cargo.toml -p desic-smoke-tools --bin smoke_trade_readiness",
    "smoke:ai-stop": "node scripts/smoke-cline-sidecar-stop.mjs",
    "smoke:ai-ready": "node scripts/smoke-cline-sidecar-ready.mjs",
    "smoke:ai-packaged-ready": "node scripts/smoke-packaged-sidecar-ready.mjs",
    "smoke:ai-restart": "node scripts/smoke-cline-sidecar-restart.mjs",
    "smoke:ai-10rounds": "node scripts/smoke-cline-sidecar-10rounds.mjs",
    "smoke:ai-subagent": "node scripts/smoke-cline-sidecar-subagent.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run dev:ready && tauri dev --no-dev-server-wait",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@cline/llms": "^0.0.56",
    "@cline/sdk": "^0.0.56",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ai": "^6.0.144",
    "ai-sdk-provider-codex-cli": "^1.2.2",
    "ajv": "^8.17.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "gsap": "^3.15.0",
    "i18next": "^25.10.10",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
